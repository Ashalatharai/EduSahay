APP_ENV=development
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://edusahaya:edusahaya@localhost:5432/edusahaya
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=60
# Optional: creates this administrator on startup if it does not exist
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Uploaded documents are encrypted at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
STORAGE_DIR=../storage
MAX_UPLOAD_MB=10
CLASSIFIER_MIN_CONFIDENCE=0.6
OCR_ENABLED=true
OCR_LANG=en
EXTRACTION_MIN_CONFIDENCE=0.7
